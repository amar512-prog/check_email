# Use development locally. Change to google in production.
AUTH_MODE=development
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_SECURE=false

# Optional machine auth for the API / Swagger (X-API-Key header). Blank = disabled.
API_KEY=
# Optional static username+password login, shown alongside Google. Both blank = disabled.
AUTH_USERNAME=
AUTH_PASSWORD=

COORDINATOR_DB=./backend/data/coordinator.db
MAX_UPLOAD_EMAILS=10000

# Use 0 for fast local testing. Production should normally use 60.
REACHER_PACING_SECONDS=0
REACHER_JOB_TIMEOUT_SECONDS=900

# How many times an email whose result is "unknown" is re-verified before the
# job completes. The wait between rounds is chosen per job in the frontend
# (1-15 minutes, default 5).
UNKNOWN_RETRY_ATTEMPTS=3

# Secrets live only here, never in the frontend.
REACHER_SERVERS_JSON='[{"name":"local-worker","url":"http://127.0.0.1:8080","secret":"replace-me","emails_per_minute":50}]'
